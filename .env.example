# Copy this file to .env and fill in real values for local/dev use.
# Never commit the actual .env file.

DB_HOST=localhost
DB_PORT=3306
DB_NAME=zestdb
DB_USERNAME=root
DB_PASSWORD=change-me

# Generate a long, random value for production, e.g.: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-characters
JWT_EXPIRATION=900000
REFRESH_TOKEN_EXPIRATION=604800000
